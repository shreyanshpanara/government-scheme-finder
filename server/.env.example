# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or local URI, fallback to in-memory if empty in dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gov_schemes?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Allowed Client Origin
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini or OpenAI API Key for AI Assistant (falls back to built-in knowledge base if empty)
AI_API_KEY=
